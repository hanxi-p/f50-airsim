[Unit]
Description=AirSIM temporary direct pairing TLS

[Service]
ExecStart=/usr/bin/stunnel4 /etc/airsim-direct/pair.conf
RuntimeMaxSec=125
SuccessExitStatus=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

# For hosts using UFW. Verify port 9443 has no pre-existing UFW rule.
ReadWritePaths=/etc/ufw /run
ExecStartPre=/usr/sbin/ufw allow 9443/tcp comment AirSIM-temporary-pairing
ExecStopPost=/usr/sbin/ufw --force delete allow 9443/tcp
