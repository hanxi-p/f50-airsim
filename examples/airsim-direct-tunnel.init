#!/bin/sh /etc/rc.common
START=99
STOP=08
USE_PROCD=1

start_service() {
    local dir=/mnt/mu300-disk/extra/airsim-f50/direct
    local server lan
    [ -r "$dir/id_dropbear" ] || return 1
    server=$(cat "$dir/vps-ip") || return 1
    lan=$(cat "$dir/lan-ip") || return 1
    for ip in "$server" "$lan"; do
        printf '%s\n' "$ip" | awk -F. 'NF==4 {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255) exit 1; ok=1} END{if(NR!=1 || !ok) exit 1}' || return 1
    done
    procd_open_instance
    procd_set_param command /usr/bin/dbclient -N -T -K 20 \
        -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes \
        -i "$dir/id_dropbear" \
        -R "127.0.0.1:18580:$lan:8580" \
        -R "127.0.0.1:18581:$lan:8581" \
        -R "127.0.0.1:18582:$lan:8582" \
        "airsim-direct@$server"
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance
}
