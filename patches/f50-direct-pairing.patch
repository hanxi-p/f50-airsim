diff --git a/internal/pairing/direct_test.go b/internal/pairing/direct_test.go
new file mode 100644
index 0000000..41d98e8
--- /dev/null
+++ b/internal/pairing/direct_test.go
@@ -0,0 +1,18 @@
+package pairing
+
+import "testing"
+
+func TestDirectRouteProof(t *testing.T) {
+	claim := Claim{SessionID: "session-1", ClientPublic: "client-key"}
+	key := "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8"
+	want := "Z2PT2cAtvHK0V8bxEDO4M6TnGPmmqFxml8cYWCI3SvM"
+	if got := DirectRouteProof(key, claim, "mu300-test", 8581, 8582); got != want {
+		t.Fatal("proof does not match the iOS canonical bytes")
+	}
+	if got := DirectRouteProof(key, claim, "mu300-test", 8582, 8581); got == want {
+		t.Fatal("proof did not bind the port roles")
+	}
+	if got := DirectRouteProof("invalid", claim, "mu300-test", 8581, 8582); got != "" {
+		t.Fatal("invalid secret accepted")
+	}
+}
