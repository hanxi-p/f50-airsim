index 4aebcbd..d278697 100644
--- a/internal/pairing/session.go
+++ b/internal/pairing/session.go
@@ -33,6 +33,19 @@ type Claim struct {
 	WantDirect   bool   `json:"want_direct_route"`
 }
 
+// DirectRouteProof binds the accepted pairing to the device and its internal ports.
+// The gateway validates the encoded secret before calling this function.
+func DirectRouteProof(encodedSecret string, claim Claim, agentID string, controlPort, pcmPort int) string {
+	secret, err := base64.RawURLEncoding.DecodeString(encodedSecret)
+	if err != nil || len(secret) != 32 {
+		return ""
+	}
+	defer clear(secret)
+	mac := hmac.New(sha256.New, secret)
+	fmt.Fprintf(mac, "AIRSIM-DIRECT1\n%s\n%s\n%s\n%d\n%d", claim.SessionID, claim.ClientPublic, agentID, controlPort, pcmPort)
+	return base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
+
